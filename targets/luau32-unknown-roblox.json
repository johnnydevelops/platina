{
  "arch": "wasm32",
  "is-like-wasm": true,
  "target-family": ["wasm"],
  "binary-format": "wasm",
  "linker-flavor": "wasm-lld",
  "lld-flavor": "wasm",
  "data-layout": "e-m:e-p:32:32-i64:64-i128:128-n32:64-S128",
  "llvm-target": "wasm32-unknown-unknown",
  "target-pointer-width": 32,
  "os": "roblox",
  "vendor": "unknown",
  "panic-strategy": "abort",
  "singlethread": true,
  "max-atomic-width": 64,
  "dynamic-linking": true,
  "only-cdylib": true,
  "dll-prefix": "",
  "dll-suffix": ".luau",
  "exe-suffix": ".luau",
  "relocation-model": "static",
  "has-thread-local": false,
  "emit-debug-gdb-scripts": false,
  "linker-is-gnu": false,
  "metadata": { "description": "Luau (Roblox) via rustc_codegen_luau", "std": false, "host_tools": false, "tier": 3 }
}
